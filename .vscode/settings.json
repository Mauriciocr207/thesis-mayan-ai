{
    "python.languageServer": "Pylance",
    "python.analysis.typeCheckingMode": "off",
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.useLibraryCodeForTypes": true,
    "python.analysis.diagnosticSeverityOverrides": {
        "reportMissingImports": "none",
        "reportOptionalMemberAccess": "none",
        "reportOptionalSubscript": "none",
        "reportGeneralTypeIssues": "none"
    },
    "python.analysis.extraPaths": [
        "projects/mayanlab",
        "projects/ytclip"
    ],
    "python.analysis.exclude": [
        "**/node_modules",
        "**/__pycache__",
        "**/.*",
        "tools/kaldi/**",
        "data/**",
        "research/**",
        "projects/speech-collector/**",
        "projects/kaldi_asr/recipe/**"
    ],
    "files.watcherExclude": {
        "**/.git/**": true,
        "**/.venv/**": true,
        "**/node_modules/**": true,
        "**/__pycache__/**": true,
        "**/tools/kaldi/**": true,
        "**/data/**": true,
        "**/research/**": true,
        "**/projects/speech-collector/**": true,
        "**/projects/kaldi_asr/recipe/**": true
    },
    "search.exclude": {
        "**/.venv": true,
        "**/node_modules": true,
        "**/tools/kaldi": true,
        "**/data/final/audio": true,
        "**/data/source": true,
        "**/projects/speech-collector": true,
        "**/projects/kaldi_asr/recipe/data": true,
        "**/projects/kaldi_asr/recipe/exp": true,
        "**/uv.lock": true
    },
    "python-envs.pythonProjects": [
        {
            "path": "projects/mms_asr/results",
            "envManager": "ms-python.python:venv",
            "packageManager": "ms-python.python:pip"
        }
    ]
}
